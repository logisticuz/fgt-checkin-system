###############################################
# 🔑 Encryption Key (required!)
###############################################
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

###############################################
# Cookie Security
###############################################
N8N_SECURE_COOKIE=true              # PROD behind HTTPS; local HTTP development may explicitly use false
N8N_DIAGNOSTICS_ENABLED=false

###############################################
# 🖥️ Host & UI Settings
###############################################
N8N_HOST=0.0.0.0
N8N_DISABLE_UI=false
N8N_RUNNERS_ENABLED=true

###############################################
# 🌐 URLs
###############################################
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678

###############################################
# 🕒 Timezone
###############################################
TZ=Europe/Stockholm

###############################################
# 🗂️ File Permissions (Prevent Volume Issues)
###############################################
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# Shared callback token: configure the same private value in backend and n8n.
INTERNAL_API_TOKEN=
# Only variables referenced by exported workflows; STARTGG_CLIENT_SECRET is not a workflow input.
N8N_ENV_ACCESS_ALLOWLIST=INTERNAL_API_TOKEN,EBAS_API_KEY,EBAS_ASSOC,STARTGG_TOKEN,STARTGG_API_KEY
