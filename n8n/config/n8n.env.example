###############################################
# 🔐 Basic Authentication
###############################################
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGEME   # ← set a strong password

###############################################
# 🔑 Encryption Key (required!)
###############################################
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

###############################################
# 👥 User Management
###############################################
N8N_USER_MANAGEMENT_DISABLED=true   # ← dev only

###############################################
# ⚠️ Cookie Security (Dev Mode - allow HTTP)
###############################################
N8N_SECURE_COOKIE=false             # ← true in prod (https)

###############################################
# 🖥️ Host & UI Settings
###############################################
N8N_HOST=0.0.0.0
N8N_DISABLE_UI=false
N8N_RUNNERS_ENABLED=true

###############################################
# 🌐 URLs
###############################################
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678

###############################################
# 🕒 Timezone
###############################################
TZ=Europe/Stockholm

###############################################
# 🗂️ File Permissions (Prevent Volume Issues)
###############################################
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# Shared callback token: configure the same private value in backend and n8n.
INTERNAL_API_TOKEN=
