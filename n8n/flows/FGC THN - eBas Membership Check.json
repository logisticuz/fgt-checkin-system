      "parameters": {
        "jsCode": "// Return a skipped/invalid-input result without any membership boolean or personnummer.\nconst state = $json.state === 'unavailable' ? 'unavailable' : 'skipped';\nreturn [{ json: { ok: false, state, skipped: state === 'skipped',\n  error: state === 'unavailable' ? 'invalid_input' : null,\n  attempt_id: $json.attempt_id, message: $json.message } }];"
